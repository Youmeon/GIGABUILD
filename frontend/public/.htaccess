Options -Indexes
# Без автоматического слэша на конце: /services отдаёт services.html, а не папку services/
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Принудительный HTTPS и адрес без www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://skdionis.ru%{REQUEST_URI} [L,R=301]

# Убираем слэш на конце: /about/ -> /about
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Страницы заранее отрендерены в .html (scripts/prerender.mjs): /about -> about.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

# Кэширование статики (имена файлов с хэшем)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
